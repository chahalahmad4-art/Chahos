# Keep both switches false until configuration and account review are complete.
ASSISTANT_CHAT_ENABLED=false
ASSISTANT_CRM_ENABLED=false
ASSISTANT_ORIGIN=https://chahosagency.vercel.app
# Pick an available Gemini text model in your own account; no default model is guessed.
GEMINI_API_KEY=
GEMINI_MODEL=
HUBSPOT_PRIVATE_APP_TOKEN=
# Upstash Redis REST (shared daily counters, deduplication and metadata telemetry)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret with at least 32 characters, never put it in public/.
ASSISTANT_HASH_SECRET=
# Site-wide provider/CRM request count; NOT a dollar spending guarantee.
ASSISTANT_DAILY_REQUEST_LIMIT=100

# Additional production gate: set only after owner approval and sandbox verification.
ASSISTANT_CRM_PRODUCTION_APPROVED=false
# Preview requires test plus a separate test-portal token and isolated Redis.
ASSISTANT_CRM_TARGET=test
# Existing note mode remains default; deal mode requires approved native pipeline IDs.
HUBSPOT_ENQUIRY_MODE=note
HUBSPOT_ENQUIRY_PIPELINE_ID=
HUBSPOT_ENQUIRY_STAGE_ID=
