# Optional. Without these the backend returns cited source extracts.
# Copy to .env and run node --env-file=.env server.mjs (Node 24).
LLM_API_KEY=
LLM_MODEL=
LLM_ENDPOINT=
# HTTPS endpoint supporting chat completions. Never put secrets under public/.
# Optional persistent local token, at least 24 characters; otherwise generated.
LAB_API_TOKEN=
PORT=8787
